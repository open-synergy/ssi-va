<odoo>
<record id="generate_va_view_form" model="ir.ui.view">
    <field name="name">generate_va - Form - operating unit</field>
    <field name="model">generate_va</field>
    <field name="inherit_id" ref="ssi_va.generate_va_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='merchant_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>
</odoo>
