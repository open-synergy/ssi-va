<odoo>
<record id="va_biller_merchant_view_search" model="ir.ui.view">
    <field name="name">va_biller_merchant - search</field>
    <field name="model">va_biller_merchant</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
        </data>
    </field>
</record>

<record id="va_biller_merchant_view_tree" model="ir.ui.view">
    <field name="name">va_biller_merchant - tree</field>
    <field name="model">va_biller_merchant</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
            </xpath>
        </data>
    </field>
</record>

<record id="va_biller_merchant_view_form" model="ir.ui.view">
    <field name="name">va_biller_merchant - form</field>
    <field name="model">va_biller_merchant</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="biller_code" string="Biller Codes">
                    <field name="biller_code_ids">
                        <tree editable="bottom">
                            <field name="biller_id" />
                            <field name="bank_id" readonly="1" />
                            <field name="merchant_code" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="va_biller_merchant_action" model="ir.actions.act_window">
    <field name="name">Virtual Account Biller Merchants</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">va_biller_merchant</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="va_biller_merchant_menu"
        name="Biller Merchants"
        action="va_biller_merchant_action"
        parent="menu_virtual_account_configuration"
    />
</odoo>
