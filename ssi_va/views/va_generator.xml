<odoo>
<record id="va_generator_view_search" model="ir.ui.view">
    <field name="name">va_generator - search</field>
    <field name="model">va_generator</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
                <field name="biller_id" />
                <field name="merchant_id" />
                <field name="type_id" />
            </xpath>
            <xpath expr="//group[@name='group_by']" position="inside">
                <filter
                        name="grp_biller_id"
                        string="Biller"
                        context="{'group_by': 'biller_id'}"
                    />
                <filter
                        name="grp_type_id"
                        string="Generator Type"
                        context="{'group_by': 'type_id'}"
                    />
            </xpath>
        </data>
    </field>
</record>

<record id="va_generator_view_tree" model="ir.ui.view">
    <field name="name">va_generator - tree</field>
    <field name="model">va_generator</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="biller_id" />
                <field name="merchant_id" optional="hide" />
                <field name="type_id" optional="hide" />
            </xpath>
        </data>
    </field>
</record>

<record id="va_generator_view_form" model="ir.ui.view">
    <field name="name">va_generator - form</field>
    <field name="model">va_generator</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="type_id" />
                <field name="biller_id" />
                <field name="merchant_id" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="source_data" string="Source Data">
                    <field name="source_data_ids">
                        <tree create="0" delete="0" edit="0">
                            <field name="model_id" />
                            <field name="res_id" />
                            <field name="source_data_id" />
                        </tree>
                    </field>
                </page>
                <page name="bank_account" string="Generated Bank Accounts">
                    <field name="bank_account_ids">
                        <tree create="0" delete="0" edit="0">
                            <field name="partner_id" />
                            <field name="bank_id" />
                            <field name="acc_number" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="va_generator_action" model="ir.actions.act_window">
    <field name="name">Virtual Account Generators</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">va_generator</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="va_generator_menu"
        name="VA Generators"
        action="va_generator_action"
        parent="ssi_financial_accounting.menu_bank_cash"
        groups="va_generator_viewer_group"
        sequence="240"
    />
</odoo>
