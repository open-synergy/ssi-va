<odoo>
<record id="va_generator_exporter_view_search" model="ir.ui.view">
    <field name="name">va_generator_exporter - search</field>
    <field name="model">va_generator_exporter</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
        </data>
    </field>
</record>

<record id="va_generator_exporter_view_tree" model="ir.ui.view">
    <field name="name">va_generator_exporter - tree</field>
    <field name="model">va_generator_exporter</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
                <field name="format" />
            </xpath>
        </data>
    </field>
</record>

<record id="va_generator_exporter_view_form" model="ir.ui.view">
    <field name="name">va_generator_exporter - form</field>
    <field name="model">va_generator_exporter</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="export_configuration" string="Export Configuration">
                    <field name="format" />
                    <field
                            name="csv_delimiter"
                            attrs="{'invisible': [('format', '!=', 'csv')]}"
                        />
                </page>
                <page name="python_code" string="Python Code">
                    <field
                            name="python_code"
                            widget="ace"
                            options="{'mode': 'python'}"
                        />
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="va_generator_exporter_action" model="ir.actions.act_window">
    <field name="name">Virtual Account Generator Exporters</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">va_generator_exporter</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="va_generator_exporter_menu"
        name="Generator Exporters"
        action="va_generator_exporter_action"
        parent="menu_virtual_account_configuration"
    />
</odoo>
