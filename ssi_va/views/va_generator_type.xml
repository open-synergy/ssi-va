<odoo>
<record id="va_generator_type_view_search" model="ir.ui.view">
    <field name="name">va_generator_type - search</field>
    <field name="model">va_generator_type</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
        </data>
    </field>
</record>

<record id="va_generator_type_view_tree" model="ir.ui.view">
    <field name="name">va_generator_type - tree</field>
    <field name="model">va_generator_type</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
            </xpath>
        </data>
    </field>
</record>

<record id="va_generator_type_view_form" model="ir.ui.view">
    <field name="name">va_generator_type - form</field>
    <field name="model">va_generator_type</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath
                    expr="//group[@name='group_1']/field[@name='active']"
                    position="before"
                >
                <field name="model_id" />
            </xpath>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="python_code" string="Python Code">
                    <field
                            name="python_code"
                            widget="ace"
                            options="{'mode': 'python'}"
                        />
                </page>
                <page
                        name="partner_python_code"
                        string="Partner Resolution Python Code"
                    >
                    <field
                            name="partner_python_code"
                            widget="ace"
                            options="{'mode': 'python'}"
                        />
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="va_generator_type_action" model="ir.actions.act_window">
    <field name="name">Virtual Account Generator Types</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">va_generator_type</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="va_generator_type_menu"
        name="Generator Types"
        action="va_generator_type_action"
        parent="menu_virtual_account_configuration"
    />
</odoo>
