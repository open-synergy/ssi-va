<odoo>
<record id="va_biller_view_search" model="ir.ui.view">
    <field name="name">va_biller - search</field>
    <field name="model">va_biller</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
        </data>
    </field>
</record>

<record id="va_biller_view_tree" model="ir.ui.view">
    <field name="name">va_biller - tree</field>
    <field name="model">va_biller</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
            </xpath>
        </data>
    </field>
</record>

<record id="va_biller_view_form" model="ir.ui.view">
    <field name="name">va_biller - form</field>
    <field name="model">va_biller</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="bank_code" string="Bank Codes">
                    <field name="bank_code_ids">
                        <tree editable="bottom">
                            <field name="bank_id" />
                            <field name="biller_code" />
                        </tree>
                        <form>
                            <group>
                                <field name="bank_id" />
                                <field name="biller_code" />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="va_biller_action" model="ir.actions.act_window">
    <field name="name">Virtual Account Billers</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">va_biller</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="va_biller_menu"
        name="Billers"
        action="va_biller_action"
        parent="menu_virtual_account_configuration"
    />
</odoo>
